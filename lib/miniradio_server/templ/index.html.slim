doctype html
html lang="en"
    head
        meta charset="UTF-8"
        meta name="viewport" content="width=device-width, initial-scale=1.0"
        title Miniradio Server
        link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css" type="text/css"
        link rel="stylesheet" href="/style/main.css" type="text/css"
        script src="https://cdn.jsdelivr.net/npm/hls.js@1" defer=true
        script src="/player.js" defer=true
    body
        header.container
            h1 Miniradio
        main.container
            section.now-playing aria-label="Current track"
                div.track-details
                    div.artwork
                        img id="currentArtwork" alt="" hidden=true
                        div id="artworkPlaceholder" aria-hidden="true"
                            span ♪
                            small No artwork
                    div.track-metadata aria-live="polite"
                        p id="playbackState" No track selected
                        h2 id="currentTrack" Select a track
                        p id="currentArtist"
                        p id="currentAlbum"
                div.custom-controls id="customControls" hidden=true
                    div.time-labels
                        span id="elapsedTime" 0:00
                        span id="durationTime" --:--
                    input id="seekControl" type="range" min="0" max="0" step="0.1" value="0" disabled=true aria-label="Playback position"
                    div.transport role="group" aria-label="Playback controls"
                        button id="prevButton" disabled=true aria-label="Previous track" ⏮ Previous
                        button id="playPauseButton" disabled=true Play
                        button id="nextButton" disabled=true aria-label="Next track" Next ⏭
                        div.volume id="volumeControls"
                            button id="muteButton" aria-pressed="false" Mute
                            label for="volumeControl" Volume
                            input id="volumeControl" type="range" min="0" max="1" step="0.01" value="1"
                        small id="volumeHint" hidden=true Use your device’s volume controls.
                    div.playback-options role="group" aria-label="Playback options"
                        button id="startButton" Play all
                        button id="loopButton" aria-pressed="false" Repeat track: OFF
                        button id="shuffleButton" aria-pressed="false" Shuffle: OFF
                audio id="player" controls=true preload="none"
                p id="playerStatus" role="status"
            h2.playlist-heading Tracks
            table.compact.striped id="playlistTable"
                thead
                    tr
                        th scope="col" Play
                        th scope="col" Title
                        th scope="col" Artist
                        th scope="col" Album
                        th scope="col" Status
                tbody
            script id="tracks" type="application/json"
                == tracks_json
        footer.container
            hr
            p Miniradio ver #{MiniradioServer::VERSION}
